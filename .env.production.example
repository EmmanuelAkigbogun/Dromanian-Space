# Environment for the complete Coolify Compose resource. Never commit real
# values. Generate each secret independently with at least 32 random bytes.
VITE_APP_NAME=Dromanian Space
VITE_APP_URL=https://darkspace.purplehive.pro

# PostgreSQL and server sessions (server-only).
POSTGRES_PASSWORD=
DATABASE_API_PASSWORD=
APP_JWT_SECRET=
DATABASE_POOL_SIZE=10
DATABASE_REST_POOL_SIZE=10
SESSION_DAYS=30
STORAGE_MAX_FILE_BYTES=52428800

# Model providers. Set one or both keys; agents run on whichever provider
# their model belongs to. The defaults apply to new workspaces only.
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_DEFAULT_ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback for supported Claude models: on | off.
ANTHROPIC_REFUSAL_FALLBACK=on
OPENAI_API_KEY=
AI_DEFAULT_OPENAI_MODEL=gpt-5.4
GEMINI_API_KEY=
# Compatibility alias also accepted: GEMINI_API=
AI_DEFAULT_GEMINI_MODEL=gemini-flash-latest
# Optional OpenAI settings.
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Optional semantic search. Without it, retrieval uses PostgreSQL full-text search.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# Worker and limits
WORKER_CONCURRENCY=4
AGENT_RUN_BUDGET_MS=600000
API_RATE_LIMIT_PER_MINUTE=300
API_AGENT_RATE_LIMIT_PER_MINUTE=30

# Optional: GET /api/jobs/run for an external scheduler (the worker does not need it).
CRON_SECRET=

# Optional n8n integration (docs/AUTOMATION.md). Callbacks are sent only to
# this host; leave empty to disable callbacks. Automation keys are created per
# workspace in Agents -> AI settings, not here.
N8N_BASE_URL=

# Loopback port of the web container, for Cloudflare Tunnel or host-proxy ingress.
WEB_HOST_PORT=3008
# Canonical company enrollment
DEFAULT_WORKSPACE_SLUG=digital-romanian
DEFAULT_CHANNEL_SLUG=general

# Private storage URL signing (falls back to APP_JWT_SECRET when empty)
STORAGE_SIGNING_SECRET=

# Calls: TURN_HOST must resolve to this server and TURN_EXTERNAL_IP must be its
# public IPv4 address. Put TLS files in /srv/app-data/dromanian-space/coturn.
TURN_HOST=turn.purplehive.pro
TURN_EXTERNAL_IP=
TURN_SHARED_SECRET=
