# Environment for the APPLICATION resource in Coolify (docker-compose.yml:
# web, api, worker). The Supabase resource has its own file:
# deploy/supabase/.env.example. Never commit real values.
#
# Build variables (Coolify: tick "Build Variable"). They are compiled into the
# browser bundle, so they must be public values only. Changing them needs a
# rebuild, not just a restart.
VITE_APP_NAME=Dromanian Space
VITE_APP_URL=https://space.digitalromanian.com
VITE_SUPABASE_URL=https://supabase-space.digitalromanian.com
# SUPABASE_PUBLISHABLE_KEY from the Supabase environment (or its legacy ANON_KEY).
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server only (api and worker). Never prefix these with VITE_.
# ---------------------------------------------------------------------------
# Private network address of the Supabase gateway (default shown).
SUPABASE_URL=http://supabase-gateway:8000
# SUPABASE_SECRET_KEY from the Supabase environment (or its legacy SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=

# Model providers. Set one or both keys; agents run on whichever provider
# their model belongs to. The defaults apply to new workspaces only.
AI_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_DEFAULT_ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback for supported Claude models: on | off.
ANTHROPIC_REFUSAL_FALLBACK=on
OPENAI_API_KEY=
AI_DEFAULT_OPENAI_MODEL=gpt-5.4
# Optional OpenAI settings.
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Optional semantic search. Without it, retrieval uses PostgreSQL full-text search.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5

# Worker and limits
WORKER_CONCURRENCY=4
AGENT_RUN_BUDGET_MS=600000
API_RATE_LIMIT_PER_MINUTE=300
API_AGENT_RATE_LIMIT_PER_MINUTE=30

# Optional: GET /api/jobs/run for an external scheduler (the worker does not need it).
CRON_SECRET=

# Optional n8n integration (docs/AUTOMATION.md). Callbacks are sent only to
# this host; leave empty to disable callbacks. Automation keys are created per
# workspace in Agents -> AI settings, not here.
N8N_BASE_URL=

# Name of the private Docker network shared with the Supabase resource.
SUPABASE_NETWORK=dromanian-supabase
# Loopback port of the web container, for Cloudflare Tunnel or host-proxy ingress.
WEB_HOST_PORT=3008
