# Local development (npm run dev:local). For production on Coolify, see
# .env.production.example.

# Public browser configuration (compiled into the SPA; safe to expose).
# The browser uses only same-origin /api routes; no database key is public.
VITE_APP_NAME=Dromanian Space
VITE_APP_URL=http://127.0.0.1:5173

# Server only (api and worker containers). Never prefix these with VITE_.
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/postgres
DATABASE_REST_URL=http://127.0.0.1:3001
APP_JWT_SECRET=
STORAGE_ROOT=.local/storage

# Model providers. The built-in team uses OpenAI (ChatGPT) gpt-6.1-sol by default.
AI_DEFAULT_PROVIDER=openai
ANTHROPIC_API_KEY=
AI_DEFAULT_ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_REFUSAL_FALLBACK=on
OPENAI_API_KEY=
AI_DEFAULT_OPENAI_MODEL=gpt-6.1-sol
GEMINI_API_KEY=
# Compatibility alias also accepted: GEMINI_API=
AI_DEFAULT_GEMINI_MODEL=gemini-3.8-flash
CEREBRAS_API_KEY=
# Compatibility alias also accepted: CEREBRAS_DIGITALROMANIAN=
AI_DEFAULT_CEREBRAS_MODEL=gpt-oss-120b

# Self-hosted LiveKit media server. Generate a unique key and 32+ byte secret.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=wss://darkspace.purplehive.pro
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# Optional Web Push for task assignments and approval requests. Generate once
# with `npx web-push generate-vapid-keys`; SUBJECT is a mailto: or https: contact.
# Changing the keys invalidates every browser subscription.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Optional ONLYOFFICE editing for Word/Excel/PowerPoint files in Drive. Any long
# random string (e.g. `openssl rand -hex 32`); editing stays off while empty.
ONLYOFFICE_JWT_SECRET=

# Optional: without Voyage, retrieval uses Postgres full-text search.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
# Optional: enables GET /api/jobs/run for an external scheduler (the worker does not need it).
CRON_SECRET=
AGENT_RUN_BUDGET_MS=600000
WORKER_CONCURRENCY=4
# Optional local browser scraper. Production Compose provisions this privately
# and generates its token automatically; these are only for a separately started
# local Crawl4AI container.
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
# Production Compose generates the token; increment this during coordinated rotation.
CRAWL4AI_TOKEN_EPOCH=1
# Optional n8n integration (callbacks only to this host).
N8N_BASE_URL=
# Optional dedicated remote browser for social login/publishing. It must use
# wss:// and support isolated BrowserContexts. Run it in an isolated sandbox;
# never put the token in browser-visible VITE_ variables.
SOCIAL_BROWSER_WS_ENDPOINT=
SOCIAL_BROWSER_TOKEN=
