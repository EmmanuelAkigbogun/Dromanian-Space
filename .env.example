# Public browser configuration (safe to bundle)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=Dromanian Space
VITE_APP_URL=http://127.0.0.1:5173

# Server only. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_REFUSAL_FALLBACK=on
# Optional: without Voyage, retrieval uses Postgres full-text search.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5
# Required for scheduled GET /api/jobs/run; generate a strong random value.
CRON_SECRET=
JOBS_BUDGET_MS=240000
