# Environment for the optional n8n resource (deploy/n8n/docker-compose.yml).
# Generate secrets with: openssl rand -hex 24   (one per value)
N8N_HOST=n8n.purplehive.pro
N8N_BIND_ADDRESS=127.0.0.1
N8N_HOST_PORT=3010
N8N_DB_PASSWORD=
# Back this up with the other configuration: it decrypts saved n8n credentials.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/Bucharest
# Dedicated key created in Agents -> AI settings -> Automation (n8n).
DROMANIAN_KEY_ID=
DROMANIAN_KEY_SECRET=
DROMANIAN_BASE_URL=https://darkspace.purplehive.pro
