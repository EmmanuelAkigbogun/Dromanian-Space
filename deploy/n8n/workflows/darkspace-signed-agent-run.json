      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst path = '/api/integrations/n8n/runs';\nconst payload = {\n  agent: 'gemini',\n  message: 'hey',\n  request_id: `n8n-smoke-${Date.now()}-${$execution.id}`,\n};\nconst rawBody = JSON.stringify(payload);\nconst timestamp = Math.floor(Date.now() / 1000).toString();\nconst material = `${timestamp}.POST.${path}.${rawBody}`;\nconst signature = 'v1=' + crypto.createHmac('sha256', $env.DROMANIAN_KEY_SECRET).update(material).digest('hex');\nreturn [{ json: {\n  url: `${$env.DROMANIAN_BASE_URL}${path}`,\n  rawBody,\n  timestamp,\n  signature,\n  keyId: $env.DROMANIAN_KEY_ID,\n} }];"
      },
