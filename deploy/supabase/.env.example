# Environment for the Supabase resource (deploy/supabase/docker-compose.yml).
# In Coolify: paste these into the Supabase resource's Environment Variables
# (mark the secret ones as secret). Outside Coolify: copy to .env next to the
# compose file, chmod 600. Never commit real values.
#
# Generate every secret with deploy/supabase/generate-env.sh (it runs the
# pinned upstream utils/generate-keys.sh and utils/add-new-auth-keys.sh).
# Values marked GENERATED come from it; do not invent them by hand.

############
# Public URLs
############
SUPABASE_PUBLIC_HOST=supabase-space.digitalromanian.com
SUPABASE_PUBLIC_URL=https://supabase-space.digitalromanian.com
# For this Supabase release the Auth external URL includes /auth/v1.
API_EXTERNAL_URL=https://supabase-space.digitalromanian.com/auth/v1

############
# Auth redirects (the application)
############
SITE_URL=https://space.digitalromanian.com
ADDITIONAL_REDIRECT_URLS=https://space.digitalromanian.com/**
DISABLE_SIGNUP=false
JWT_EXPIRY=3600
ENABLE_EMAIL_SIGNUP=true
# Keep false in production: users confirm their email address.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# SMTP (required: confirmation, invitation, password reset)
############
SMTP_ADMIN_EMAIL=no-reply@digitalromanian.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Dromanian Space

############
# Optional OAuth (callback: ${API_EXTERNAL_URL}/callback)
############
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=

############
# Secrets (GENERATED)
############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

# Asymmetric signing keys and opaque API keys (GENERATED by add-new-auth-keys.sh).
# SUPABASE_PUBLISHABLE_KEY goes to the app as VITE_SUPABASE_ANON_KEY;
# SUPABASE_SECRET_KEY goes to the app's api and worker (never the browser).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

############
# Database and pooler (internal only; no host ports)
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_TENANT_ID=dromanian-space
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

############
# API, storage, functions
############
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
# Upload limit in bytes (50 MB). Keep in sync with any bucket limits.
STORAGE_FILE_SIZE_LIMIT=52428800
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true
FUNCTIONS_VERIFY_JWT=false

############
# Gateway and Studio
############
# Loopback port of the gateway: Studio through an SSH tunnel
# (ssh -L 3009:127.0.0.1:3009 <server>) and, on servers using Cloudflare
# Tunnel ingress, the path-restricted public route (deploy/cloudflared/).
API_GW_HTTP_PORT=3009
STUDIO_DEFAULT_ORGANIZATION=Dromanian Space
STUDIO_DEFAULT_PROJECT=Dromanian Space
# Optional key for Studio's own SQL assistant (unrelated to the app's agents).
STUDIO_OPENAI_API_KEY=
