# Copy to /srv/app-data/dromanian-space/config/backup.env (chmod 600).
# Read by dromanian-backup.service; no secrets other than file paths.
AGE_RECIPIENTS_FILE=/srv/app-data/dromanian-space/config/backup-recipients.txt
# File containing the postgres password (same value as POSTGRES_PASSWORD).
PGPASSWORD_FILE=/srv/app-data/dromanian-space/config/db-password
# Exact Docker Compose project label for the Darkspace app. Required unless an
# explicit DB_CONTAINER is set. On Coolify this is the resource/project label,
# not a display name; inspect com.docker.compose.project to confirm it.
APP_COMPOSE_PROJECT=
# DB_CONTAINER=
DB_USER=postgres
RETENTION_DAYS=14
# Required off-server copy (rclone remote configured for root). The backup
# fails closed when this is empty; a successful check writes an exact proof.
RCLONE_REMOTE=
# Optional monitoring ping (healthchecks.io / Uptime Kuma push URL).
HEALTHCHECK_URL=
# Optional overrides: the exact API and worker are found by Compose labels and
# paused only while the local database/files/config snapshot is captured. Set
# names only to pin deliberately selected containers; labels and commands are
# still verified and ambiguity fails closed.
API_CONTAINER=
WORKER_CONTAINER=
# N8N_DB_CONTAINER adds the n8n database.
N8N_DB_CONTAINER=
# Preferred for Coolify Compose resources whose timestamped container name
# changes on every deploy. The backup resolves the running n8n-db by labels.
N8N_COMPOSE_PROJECT=
