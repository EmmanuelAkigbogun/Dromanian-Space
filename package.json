{
  "name": "dark-space",
  "private": true,
  "version": "1.0.0",
  "description": "Darkspace — the self-hosted Digital Romanian workspace",
  "author": "Digital Romanian",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "database:local": "tsx tools/local-database/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:local": "node --import tsx --env-file=.local/database/env scripts/dev.ts",
    "types:platform": "node --import tsx scripts/generate-platform-types.ts",
    "build:server": "esbuild server/main.ts server/worker-main.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outdir=dist-server --out-extension:.js=.mjs",
    "start:api": "node --enable-source-maps dist-server/main.mjs",
    "start:worker": "node --enable-source-maps dist-server/worker-main.mjs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "db:check": "node tools/pglite-check/run.mjs",
    "desktop:icons": "node scripts/build-desktop-icons.mjs",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:build": "npm run desktop:icons && electron-builder --win nsis portable",
    "desktop:build:installer": "npm run desktop:icons && electron-builder --win nsis",
    "pwa:icons": "node scripts/build-pwa-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.30.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "fflate": "^0.8.3",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.1",
    "mammoth": "^1.13.0",
    "openai": "^6.49.0",
    "pg": "^8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.4",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-pgvector": "0.0.11",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jose": "^6.2.12",
    "oxlint": "^1.71.0",
    "png-to-ico": "^3.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "mammoth": {
      "argparse": "3.0.0"
    }
  },
  "build": {
    "appId": "pro.purplehive.darkspace",
    "productName": "Darkspace",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Darkspace-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Darkspace"
    },
    "portable": {
      "artifactName": "Darkspace-Portable-${version}-${arch}.${ext}"
    }
  }
}
